Subject: [PATCH] dt-bindings: describe aichi,ami603
Upstream-Status: Pending

Describe required device resources separately from board wiring, with
explicit supplies and GPIO roles for validation of the runtime device tree.

---
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/magnetometer/aichi,ami603.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/magnetometer/aichi,ami603.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Aichi Steel AMI603 six-axis magnetometer and accelerometer
+
+maintainers:
+  - Freya Fractal <24643711+highenergymagic@users.noreply.github.com>
+
+description: |
+  I2C six-axis sensor with factory-programmed sensitivity and offset values.
+  The driver uses direct-mode measurements and polls data-ready status.
+
+properties:
+  compatible:
+    const: aichi,ami603
+
+  reg:
+    maxItems: 1
+
+  vdd-supply: true
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        motion-sensor@f {
+            compatible = "aichi,ami603";
+            reg = <0x0f>;
+            vdd-supply = <&sensor_vdd>;
+        };
+    };
