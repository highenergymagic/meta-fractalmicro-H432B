# WM8983 diagnostic playback. No OSS emulation, capture, or auto-play.
CONFIG_LOCALVERSION="-u2-audio4"
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SAMSUNG=y
CONFIG_SND_SAMSUNG_I2S=y
CONFIG_SND_SOC_HIMS_U2=y
CONFIG_SND_SOC_WM8983=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_GPIO=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
