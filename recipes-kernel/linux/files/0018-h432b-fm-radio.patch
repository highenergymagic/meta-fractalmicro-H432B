+	struct v4l2_ctrl *mute;
+	struct v4l2_ctrl *volume;
+	unsigned int spacing;
+	bool deemphasis_50us;
+
 	/* si470x ops */

 	int (*get_register)(struct si470x_device *radio, int regnr);
@@ -181,6 +188,9 @@
 #if IS_ENABLED(CONFIG_I2C_SI470X)
