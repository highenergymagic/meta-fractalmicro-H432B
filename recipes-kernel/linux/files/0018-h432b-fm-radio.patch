 /*
  * si470x_start - switch on radio
  */
+static int si4702_start(struct si470x_device *radio)
+{
+	int ret;
+
+	/* Preserve requested mono/mute state; Si4702 has no RDS registers. */
+	radio->registers[POWERCFG] = POWERCFG_ENABLE |
+		(radio->registers[POWERCFG] & POWERCFG_MONO) |
+		(radio->mute->val ? 0 : POWERCFG_DMUTE);
+	ret = radio->set_register(radio, POWERCFG);
+	if (ret)
+		return ret;
+	msleep(110);
+	radio->registers[SYSCONFIG1] = SYSCONFIG1_GPIO2_INT |
+		(radio->deemphasis_50us ? SYSCONFIG1_DE : 0);
+	radio->registers[SYSCONFIG2] = (0x10 << 8) |
+		((radio->band << 6) & SYSCONFIG2_BAND) |
+		((radio->spacing << 4) & SYSCONFIG2_SPACE) | radio->volume->val;
+	ret = radio->set_register(radio, SYSCONFIG2);
+	if (ret)
+		return ret;
+	return si470x_set_chan_polled(radio, radio->registers[CHANNEL] & CHANNEL_CHAN);
+}
