 EXPORT_SYMBOL_GPL(si470x_set_freq);

+static int si470x_seek_polled(struct si470x_device *radio,
+			      const struct v4l2_hw_freq_seek *seek)
+{
+	u16 old_config = radio->registers[SYSCONFIG2];
+	int old_band = radio->band, band = old_band;
+	unsigned int old_frequency, frequency, spacing;
+	int ret, cleanup, restore;
+
+	if (seek->type != V4L2_TUNER_RADIO)
+		return -EINVAL;
+	if (seek->rangelow || seek->rangehigh) {
+		for (band = 0; band < ARRAY_SIZE(bands); band++) {
+			if (bands[band].rangelow == seek->rangelow &&
+			    bands[band].rangehigh == seek->rangehigh)
+				break;
+		}
+		if (band == ARRAY_SIZE(bands))
+			return -EINVAL;
+	}
+	ret = si470x_get_freq(radio, &old_frequency);
+	if (ret)
+		return ret;
+	ret = si470x_set_band(radio, band);
+	if (ret)
+		goto restore_frequency;
+	if (seek->spacing) {
+		/* V4L2 requests Hz; select the nearest supported spacing. */
+		spacing = seek->spacing < 75000 ? 2 : seek->spacing < 150000 ? 1 : 0;
+		radio->registers[SYSCONFIG2] &= ~SYSCONFIG2_SPACE;
+		radio->registers[SYSCONFIG2] |= spacing << 4;
+		ret = radio->set_register(radio, SYSCONFIG2);
+		if (ret)
+			goto restore_frequency;
+	}
+	frequency = clamp(old_frequency, bands[band].rangelow, bands[band].rangehigh);
+	ret = si470x_set_freq(radio, frequency);
+	if (ret)
+		goto restore_frequency;
+
+	/* End any preceding operation before requesting a new hardware seek. */
+	radio->registers[POWERCFG] &= ~POWERCFG_SEEK;
+	radio->registers[CHANNEL] &= ~CHANNEL_TUNE;
+	ret = radio->set_register(radio, CHANNEL);
+	if (ret)
+		goto stop_seek;
+	ret = si470x_poll_stc(radio, false, tune_timeout);
+	if (ret)
+		goto stop_seek;
+	radio->registers[POWERCFG] &= ~(POWERCFG_SKMODE | POWERCFG_SEEKUP);
+	radio->registers[POWERCFG] |= POWERCFG_SEEK;
+	if (!seek->wrap_around)
+		radio->registers[POWERCFG] |= POWERCFG_SKMODE;
+	if (seek->seek_upward)
+		radio->registers[POWERCFG] |= POWERCFG_SEEKUP;
+	ret = radio->set_register(radio, POWERCFG);
+	if (!ret)
+		ret = si470x_poll_stc(radio, true, seek_timeout);
+	if (!ret && (radio->registers[STATUSRSSI] & STATUSRSSI_SF))
+		ret = -ENODATA;
+	if (!ret) {
+		ret = radio->get_register(radio, READCHAN);
+		if (!ret)
+			radio->registers[CHANNEL] =
+				(radio->registers[CHANNEL] & ~CHANNEL_CHAN) |
+				(radio->registers[READCHAN] & READCHAN_READCHAN);
+	}
+stop_seek:
+	radio->registers[POWERCFG] &= ~POWERCFG_SEEK;
+	cleanup = radio->set_register(radio, POWERCFG);
+	if (!cleanup)
+		cleanup = si470x_poll_stc(radio, false, tune_timeout);
+	ret = ret ?: cleanup;
+	if (!ret) {
+		radio->spacing = (radio->registers[SYSCONFIG2] & SYSCONFIG2_SPACE) >> 4;
+		return 0;
+	}
+
+restore_frequency:
+	/* The V4L2 ABI requires the original frequency when seeking fails. */
+	radio->band = old_band;
+	radio->registers[SYSCONFIG2] = old_config;
+	restore = radio->set_register(radio, SYSCONFIG2);
+	if (!restore)
+		restore = si470x_set_freq(radio, old_frequency);
+	if (restore)
+		dev_err_ratelimited(&radio->videodev.dev,
+				    "cannot restore frequency after failed seek: %d\n", restore);
+	return restore ?: ret;
+}
