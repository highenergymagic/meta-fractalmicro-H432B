 /*
  * si470x_set_chan - set the channel
  */
+static int si470x_poll_stc(struct si470x_device *radio, bool high,
+			   unsigned int timeout)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(timeout);
+	int ret;
+
+	do {
+		ret = radio->get_register(radio, STATUSRSSI);
+		if (ret)
+			return ret;
+		if (!!(radio->registers[STATUSRSSI] & STATUSRSSI_STC) == high)
+			return 0;
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	return -ETIMEDOUT;
+}
+
+static int si470x_set_chan_polled(struct si470x_device *radio, unsigned short chan)
+{
+	int ret, cleanup;
+
+	/* STC must fall before a new request and after TUNE is cleared. */
+	radio->registers[CHANNEL] &= ~CHANNEL_TUNE;
+	ret = radio->set_register(radio, CHANNEL);
+	if (ret)
+		return ret;
+	ret = si470x_poll_stc(radio, false, tune_timeout);
+	if (ret)
+		return ret;
+	radio->registers[CHANNEL] =
+		(radio->registers[CHANNEL] & ~CHANNEL_CHAN) | CHANNEL_TUNE | chan;
+	ret = radio->set_register(radio, CHANNEL);
+	if (!ret)
+		ret = si470x_poll_stc(radio, true, tune_timeout);
+	radio->registers[CHANNEL] &= ~CHANNEL_TUNE;
+	cleanup = radio->set_register(radio, CHANNEL);
+	if (!cleanup)
+		cleanup = si470x_poll_stc(radio, false, tune_timeout);
+	return ret ?: cleanup;
+}
+
 static int si470x_set_chan(struct si470x_device *radio, unsigned short chan)
 {
 	int retval;
 	unsigned long time_left;
 	bool timed_out = false;

+	if (radio->is_si4702)
+		return si470x_set_chan_polled(radio, chan);
+
 	retval = radio->get_register(radio, POWERCFG);
 	if (retval)
 		return retval;
