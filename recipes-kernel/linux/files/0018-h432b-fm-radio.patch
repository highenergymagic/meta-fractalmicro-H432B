  * File Operations Interface
  **************************************************************************/

+static void si4702_power_off(void *data)
+{
+	struct si470x_device *radio = data;
+	int ret;
+
+	gpiod_set_value_cansleep(radio->gpio_reset, 1);
+	if (!radio->vdd_enabled)
+		return;
+	ret = regulator_disable(radio->vdd);
+	if (ret)
+		dev_err(&radio->client->dev, "cannot disable tuner supply: %d\n", ret);
+	else
+		radio->vdd_enabled = false;
+}
+
+static int si4702_init(struct si470x_device *radio)
+{
+	struct device *dev = &radio->client->dev;
+	u32 value;
+	int ret;
+
+	radio->spacing = 2;
+	ret = device_property_read_u32(dev, "silabs,channel-spacing-khz", &value);
+	if (!ret) {
+		switch (value) {
+		case 200:
+			radio->spacing = 0;
+			break;
+		case 100:
+			radio->spacing = 1;
+			break;
+		case 50:
+			break;
+		default:
+			return dev_err_probe(dev, -EINVAL, "invalid channel spacing\n");
+		}
+	} else if (device_property_present(dev, "silabs,channel-spacing-khz")) {
+		return dev_err_probe(dev, ret, "invalid channel spacing property\n");
+	}
+	radio->deemphasis_50us = true;
+	ret = device_property_read_u32(dev, "silabs,deemphasis-us", &value);
+	if (!ret) {
+		if (value != 50 && value != 75)
+			return dev_err_probe(dev, -EINVAL, "invalid de-emphasis\n");
+		radio->deemphasis_50us = value == 50;
+	} else if (device_property_present(dev, "silabs,deemphasis-us")) {
+		return dev_err_probe(dev, ret, "invalid de-emphasis property\n");
+	}
+	radio->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(radio->vdd))
+		return dev_err_probe(dev, PTR_ERR(radio->vdd), "tuner supply\n");
+	radio->gpio_reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(radio->gpio_reset))
+		return dev_err_probe(dev, PTR_ERR(radio->gpio_reset), "reset GPIO\n");
+	usleep_range(1000, 2000);
+	ret = regulator_enable(radio->vdd);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable tuner supply\n");
+	radio->vdd_enabled = true;
+	ret = devm_add_action_or_reset(dev, si4702_power_off, radio);
+	if (ret)
+		return ret;
+	usleep_range(10000, 12000);
+	gpiod_set_value_cansleep(radio->gpio_reset, 0);
+	msleep(100);
+	ret = si470x_get_all_registers(radio);
+	if (ret)
+		return ret;
+	/* The C19 part has these identification registers before power-up. */
+	if (radio->registers[DEVICEID] != 0x1242 ||
+	    radio->registers[SI_CHIPID] != 0x1000)
+		return dev_err_probe(dev, -ENODEV, "Si4702-C19 identity mismatch\n");
+	if (device_property_read_bool(dev, "silabs,use-crystal")) {
+		/* Preserve the reset value of reserved bits in TEST1. */
+		radio->registers[TEST1] |= BIT(15);
+		ret = si470x_set_register(radio, TEST1);
+		if (ret)
+			return ret;
+		msleep(500);
+	}
+	radio->band = 0;
+	radio->videodev.device_caps = V4L2_CAP_TUNER | V4L2_CAP_RADIO | V4L2_CAP_HW_FREQ_SEEK;
+	return 0;
+}
