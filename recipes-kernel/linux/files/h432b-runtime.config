# SPDX-License-Identifier: MIT
# Production paths retain PM support without test-only suspend controls.
# CONFIG_PM_DEBUG is not set
# CONFIG_PM_SLEEP_DEBUG is not set
# CONFIG_PM_TEST_SUSPEND is not set
# Cortex-A8 scalar AES acceleration; no asynchronous/NEON crypto requirement.
CONFIG_CRYPTO_AES_ARM=y
# On-demand systembase integrity, above UBI's NAND management and ECC.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256_ARM=y
# Removable SD and USB storage; built in so mounting needs no module lookup.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
# Upstream S5PV210 hardware reset watchdog; owned by systemd at runtime.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_S3C2410_WATCHDOG=y
# CONFIG_WATCHDOG_NOWAYOUT is not set
# Internal SD: verified extensions, scratch space and persistent state.
CONFIG_BTRFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
