Subject: [PATCH] dt-bindings: media: document Si4702-C19 receiver
Upstream-Status: Pending

Describe the receiver's supply, reset and clock selection independently of
board wiring. Channel spacing and de-emphasis are configurable by firmware.

---
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/silabs,si4702.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/silabs,si4702.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Labs Si4702-C19 FM radio receiver
+
+maintainers:
+  - Freya Fractal <24643711+highenergymagic@users.noreply.github.com>
+
+description: |
+  I2C-controlled FM receiver without RDS decoding. Tune/seek completion is polled.
+  The reset input selects I2C mode with the board's interface strapping.
+  A 32.768 kHz reference must be supplied externally unless use-crystal selects
+  the integrated crystal oscillator. Other board control signals belong to
+  regulators or GPIO hogs, not this receiver's register interface.
+
+properties:
+  compatible:
+    const: silabs,si4702-c19
+
+  reg:
+    maxItems: 1
+
+  vdd-supply: true
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low reset input.
+
+  silabs,use-crystal:
+    type: boolean
+    description: Enable the integrated 32.768 kHz crystal oscillator.
+
+  silabs,channel-spacing-khz:
+    description: Default receive channel spacing, in kilohertz.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [50, 100, 200]
+    default: 50
+
+  silabs,deemphasis-us:
+    description: FM audio de-emphasis time constant, in microseconds.
+    enum: [50, 75]
+    default: 50
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - reset-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        tuner@10 {
+            compatible = "silabs,si4702-c19";
+            reg = <0x10>;
+            vdd-supply = <&fm_vdd>;
+            reset-gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
+            silabs,use-crystal;
+            silabs,channel-spacing-khz = <100>;
+            silabs,deemphasis-us = <50>;
+        };
+    };
