Subject: [PATCH] hims u2 audio

Upstream-Status: Inappropriate [H432B board-specific audio wiring]

diff --git a/sound/soc/samsung/Kconfig b/sound/soc/samsung/Kconfig
--- a/sound/soc/samsung/Kconfig
+++ b/sound/soc/samsung/Kconfig
@@ -11,6 +11,13 @@
 
 if SND_SOC_SAMSUNG
 
+config SND_SOC_HIMS_U2
+	tristate "H432B WM8983 audio"
+	depends on OF && SPI_MASTER && GPIOLIB
+	select SND_SAMSUNG_I2S
+	select SND_SOC_WM8983
+
+
 config SND_SAMSUNG_PCM
 	tristate "Samsung PCM interface support"
 
diff --git a/sound/soc/samsung/Makefile b/sound/soc/samsung/Makefile
--- a/sound/soc/samsung/Makefile
+++ b/sound/soc/samsung/Makefile
@@ -42,3 +42,5 @@
 obj-$(CONFIG_SND_SOC_SAMSUNG_TM2_WM5110) += snd-soc-tm2-wm5110.o
 obj-$(CONFIG_SND_SOC_SAMSUNG_ARIES_WM8994) += snd-soc-aries-wm8994.o
 obj-$(CONFIG_SND_SOC_SAMSUNG_MIDAS_WM1811) += snd-soc-midas-wm1811.o
+
+obj-$(CONFIG_SND_SOC_HIMS_U2) += hims-u2-audio.o
diff --git a/sound/soc/samsung/hims-u2-audio.c b/sound/soc/samsung/hims-u2-audio.c
new file mode 100644
--- /dev/null
+++ b/sound/soc/samsung/hims-u2-audio.c
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * H432B diagnostic playback: CE-proven WM8983 GPIO control and I2S0.
+ * First port accepts only 44.1 kHz / stereo / S16_LE.
+ * CE enables both HP and SPK pairs; their analog wiring is not yet isolated.
+ * No capture or jack IRQ support yet.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include "../codecs/wm8983.h"
+#include "i2s.h"
+
+struct u2_audio {
+	struct snd_soc_card card;
+	struct snd_soc_dai_link link;
+	struct snd_soc_dai_link_component cpu, codec, platform;
+	struct gpio_desc *unmute, *speaker;
+};
+
+static void u2_mute(void *data)
+{
+	struct u2_audio *u2 = data;
+
+	gpiod_set_value_cansleep(u2->unmute, 0);
+	gpiod_set_value_cansleep(u2->speaker, 0);
+}
+
+static int u2_speaker_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct u2_audio *u2 = snd_soc_card_get_drvdata(w->dapm->card);
+
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		/* Stock HwUnMute: speaker high, 50 ms, unmute high. */
+		gpiod_set_value_cansleep(u2->speaker, 1);
+		msleep(50);
+		gpiod_set_value_cansleep(u2->unmute, 1);
+		msleep(200);
+	} else {
+		u2_mute(u2);
+		msleep(50);
+	}
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget u2_widgets[] = {
+	SND_SOC_DAPM_SPK("Internal Speaker", u2_speaker_event),
+};
+
+static const struct snd_soc_dapm_route u2_routes[] = {
+	{ "Internal Speaker", NULL, "HPL" },
+	{ "Internal Speaker", NULL, "HPR" },
+	{ "Internal Speaker", NULL, "SPKL" },
+	{ "Internal Speaker", NULL, "SPKR" },
+};
+
+static const struct snd_kcontrol_new u2_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Internal Speaker"),
+};
+
+static int u2_link_init(struct snd_soc_pcm_runtime *rtd)
+{
+	/* Binding the card must not automatically unmute the box. */
+	snd_soc_dapm_disable_pin(&rtd->card->dapm, "Internal Speaker");
+	return snd_soc_dapm_sync(&rtd->card->dapm);
+}
+
+/*
+ * Board analogue gain ceiling: floor(63 * 0.80) = 50, -7 dB analogue gain.
+ * Both pairs are limited until the internal amplifier input is isolated.
+ * This limits normal ALSA controls; it is not a calibrated speaker rating.
+ */
+#define U2_ANALOG_VOLUME_MAX 50
+
+static int u2_late_probe(struct snd_soc_card *card)
+{
+	int ret;
+
+	ret = snd_soc_limit_volume(card, "Headphone Playback Volume",
+				   U2_ANALOG_VOLUME_MAX);
+	if (ret < 0)
+		return ret;
+	ret = snd_soc_limit_volume(card, "Speaker Playback Volume",
+				   U2_ANALOG_VOLUME_MAX);
+	if (ret < 0)
+		return ret;
+	dev_dbg(card->dev, "HP/SPK analogue volume limited to %u/63\n",
+		 U2_ANALOG_VOLUME_MAX);
+	return 0;
+}
+
+static int u2_startup(struct snd_pcm_substream *s)
+{
+	int ret;
+
+	ret = snd_pcm_hw_constraint_single(s->runtime,
+			SNDRV_PCM_HW_PARAM_RATE, 44100);
+	if (ret)
+		return ret;
+	ret = snd_pcm_hw_constraint_single(s->runtime,
+			SNDRV_PCM_HW_PARAM_CHANNELS, 2);
+	if (ret)
+		return ret;
+	return snd_pcm_hw_constraint_mask64(s->runtime,
+			SNDRV_PCM_HW_PARAM_FORMAT, SNDRV_PCM_FMTBIT_S16_LE);
+}
+
+static int u2_hw_params(struct snd_pcm_substream *s,
+			struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(s);
+	struct snd_soc_dai *cpu = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec = snd_soc_rtd_to_codec(rtd, 0);
+	int ret;
+
+	if (params_rate(params) != 44100 || params_channels(params) != 2 ||
+	    params_format(params) != SNDRV_PCM_FORMAT_S16_LE)
+		return -EINVAL;
+	ret = snd_soc_dai_set_sysclk(cpu, SAMSUNG_I2S_OPCLK, 0,
+				    SAMSUNG_I2S_OPCLK_PCLK);
+	if (ret)
+		return ret;
+	ret = snd_soc_dai_set_sysclk(cpu, SAMSUNG_I2S_RCLKSRC_1, 0,
+				    SND_SOC_CLOCK_IN);
+	if (ret)
+		return ret;
+	ret = snd_soc_dai_set_sysclk(cpu, SAMSUNG_I2S_CDCLK, 384,
+				    SND_SOC_CLOCK_OUT);
+	if (ret)
+		return ret;
+	ret = snd_soc_dai_set_clkdiv(cpu, SAMSUNG_I2S_DIV_BCLK, 32);
+	if (ret)
+		return ret;
+	/* CE EPLL/4 is 16934501.5 Hz: approximately +6 ppm from 384fs. */
+	return snd_soc_dai_set_sysclk(codec, WM8983_CLKSRC_MCLK,
+				     16934400, SND_SOC_CLOCK_IN);
+}
+
+static const struct snd_soc_ops u2_ops = {
+	.startup = u2_startup,
+	.hw_params = u2_hw_params,
+};
+
+static void u2_put_node(void *node)
+{
+	of_node_put(node);
+}
+
+static int u2_get_node(struct device *dev, const char *name,
+		       struct device_node **node)
+{
+	*node = of_parse_phandle(dev->of_node, name, 0);
+	if (!*node)
+		return -EINVAL;
+	return devm_add_action_or_reset(dev, u2_put_node, *node);
+}
+
+static int u2_audio_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct u2_audio *u2;
+	struct clk *epll, *audmux, *i2smux, *bus, *i2s;
+	int ret;
+
+	u2 = devm_kzalloc(dev, sizeof(*u2), GFP_KERNEL);
+	if (!u2)
+		return -ENOMEM;
+	u2->unmute = devm_gpiod_get(dev, "unmute", GPIOD_OUT_LOW);
+	if (IS_ERR(u2->unmute))
+		return dev_err_probe(dev, PTR_ERR(u2->unmute), "unmute GPIO\n");
+	u2->speaker = devm_gpiod_get(dev, "speaker", GPIOD_OUT_LOW);
+	if (IS_ERR(u2->speaker))
+		return dev_err_probe(dev, PTR_ERR(u2->speaker), "speaker GPIO\n");
+	ret = devm_add_action_or_reset(dev, u2_mute, u2);
+	if (ret)
+		return ret;
+
+	epll = devm_clk_get(dev, "epll");
+	audmux = devm_clk_get(dev, "audmux");
+	i2smux = devm_clk_get(dev, "i2smux");
+	bus = devm_clk_get(dev, "bus");
+	i2s = devm_clk_get(dev, "i2s");
+	if (IS_ERR(epll))
+		return dev_err_probe(dev, PTR_ERR(epll), "EPLL\n");
+	if (IS_ERR(audmux))
+		return dev_err_probe(dev, PTR_ERR(audmux), "AUDSS mux\n");
+	if (IS_ERR(i2smux))
+		return dev_err_probe(dev, PTR_ERR(i2smux), "I2S mux\n");
+	if (IS_ERR(bus))
+		return dev_err_probe(dev, PTR_ERR(bus), "audio bus\n");
+	if (IS_ERR(i2s))
+		return dev_err_probe(dev, PTR_ERR(i2s), "I2S clock\n");
+	ret = clk_set_rate(epll, 67738006);
+	if (ret)
+		return dev_err_probe(dev, ret, "EPLL rate\n");
+	ret = clk_set_parent(audmux, epll);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(i2smux, audmux);
+	if (ret)
+		return ret;
+	ret = clk_set_rate(bus, 67738006);
+	if (ret)
+		return ret;
+	ret = clk_set_rate(i2s, 16934502);
+	if (ret)
+		return ret;
+	if (clk_get_rate(bus) != 67738006)
+		return dev_err_probe(dev, -EINVAL, "unexpected audio bus rate\n");
+
+	ret = u2_get_node(dev, "hims,i2s-controller", &u2->cpu.of_node);
+	if (ret)
+		return ret;
+	ret = u2_get_node(dev, "hims,audio-codec", &u2->codec.of_node);
+	if (ret)
+		return ret;
+	u2->platform.of_node = u2->cpu.of_node;
+	u2->codec.dai_name = "wm8983-hifi";
+	u2->link.name = "WM8983";
+	u2->link.stream_name = "U2 Playback";
+	u2->link.cpus = &u2->cpu;
+	u2->link.num_cpus = 1;
+	u2->link.codecs = &u2->codec;
+	u2->link.num_codecs = 1;
+	u2->link.platforms = &u2->platform;
+	u2->link.num_platforms = 1;
+	u2->link.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			   SND_SOC_DAIFMT_CBS_CFS;
+	u2->link.playback_only = 1;
+	u2->link.init = u2_link_init;
+	u2->link.ops = &u2_ops;
+	u2->card.name = "OpenH432";
+	u2->card.late_probe = u2_late_probe;
+	u2->card.owner = THIS_MODULE;
+	u2->card.dev = dev;
+	u2->card.dai_link = &u2->link;
+	u2->card.num_links = 1;
+	u2->card.controls = u2_controls;
+	u2->card.num_controls = ARRAY_SIZE(u2_controls);
+	u2->card.dapm_widgets = u2_widgets;
+	u2->card.num_dapm_widgets = ARRAY_SIZE(u2_widgets);
+	u2->card.dapm_routes = u2_routes;
+	u2->card.num_dapm_routes = ARRAY_SIZE(u2_routes);
+	snd_soc_card_set_drvdata(&u2->card, u2);
+	platform_set_drvdata(pdev, u2);
+	return devm_snd_soc_register_card(dev, &u2->card);
+}
+
+static void u2_audio_shutdown(struct platform_device *pdev)
+{
+	u2_mute(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id u2_audio_of_match[] = {
+	{ .compatible = "hims,h432b-audio" },
+	{ .compatible = "hims,u2-audio-diagnostic" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, u2_audio_of_match);
+
+static struct platform_driver u2_audio_driver = {
+	.probe = u2_audio_probe,
+	.shutdown = u2_audio_shutdown,
+	.driver = {
+		.name = "h432b-audio",
+		.of_match_table = u2_audio_of_match,
+	},
+};
+module_platform_driver(u2_audio_driver);
+MODULE_DESCRIPTION("H432B WM8983 audio");
+MODULE_LICENSE("GPL");
