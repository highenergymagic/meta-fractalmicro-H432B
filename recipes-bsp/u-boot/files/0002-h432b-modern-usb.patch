diff --git a/board/fractalmicro/h432b/usb.c b/board/fractalmicro/h432b/usb.c
new file mode 100644
index 00000000..c85b93a9
--- /dev/null
+++ b/board/fractalmicro/h432b/usb.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* S5PV210 device PHY sequence used by the H432B factory loader. */
+#include <env.h>
+#include <g_dnl.h>
+#include <init.h>
+#include <usb.h>
+#include <usb/dwc2_udc.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+
+#define H432B_CLK_GATE ((void __iomem *)0xe0100464)
+#define H432B_OSC_CON ((void __iomem *)0xe0108000)
+#define H432B_PHY_CTRL ((void __iomem *)0xe010e80c)
+#define H432B_PHY_PWR ((void __iomem *)0xec100000)
+#define H432B_PHY_CLK ((void __iomem *)0xec100004)
+#define H432B_PHY_RST ((void __iomem *)0xec100008)
+#define H432B_OTG_DCTL ((void __iomem *)0xec000804)
+#define H432B_WTCON ((void __iomem *)0xe2700000)
+
+int board_early_init_f(void)
+{
+	/* The maintenance image, not EBOOT's watchdog, owns its lifetime. */
+	writel(0, H432B_WTCON);
+	return 0;
+}
+
+void otg_phy_init(struct dwc2_udc *dev)
+{
+	setbits_le32(H432B_CLK_GATE, BIT(16));
+	udelay(1000);
+	setbits_le32(H432B_OTG_DCTL, BIT(1));
+	setbits_le32(H432B_OSC_CON, BIT(1));
+	setbits_le32(H432B_PHY_CTRL, BIT(0) | BIT(1));
+	writel(0x30, H432B_PHY_PWR);
+	writel(0x03, H432B_PHY_CLK);
+	writel(0x01, H432B_PHY_RST);
+	udelay(10);
+	writel(0x00, H432B_PHY_RST);
+	udelay(10);
+}
+
+void otg_phy_off(struct dwc2_udc *dev)
+{
+	/* Disconnect the device without gating shared host/oscillator rails. */
+	setbits_le32(H432B_OTG_DCTL, BIT(1));
+}
+
+static struct dwc2_plat_otg_data h432b_otg = {
+	.regs_phy = 0xec100000,
+	.regs_otg = 0xec000000,
+	.usb_phy_ctrl = 0xe010e80c,
+};
+
+int board_usb_init(int index, enum usb_init_type init)
+{
+	if (index || init != USB_INIT_DEVICE)
+		return -ENODEV;
+	g_dnl_set_product("Braille Sense U2 (Maintenance)");
+	env_set("board", "h432b");
+	return dwc2_udc_probe(&h432b_otg);
+}
+
+int board_usb_cleanup(int index, enum usb_init_type init)
+{
+	return 0;
+}
