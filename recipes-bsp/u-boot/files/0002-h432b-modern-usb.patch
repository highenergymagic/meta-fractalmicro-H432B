 	},
 	[FASTBOOT_COMMAND_SET_ACTIVE] =  {
 		.command = "set_active",
-		.dispatch = okay
+		.dispatch = fastboot_set_active
 	},
 	[FASTBOOT_COMMAND_OEM_FORMAT] = {
 		.command = "oem format",
@@ -210,6 +210,11 @@ static void okay(char *cmd_parameter, char *response)
 	fastboot_okay(NULL, response);
 }
 
+__weak void fastboot_set_active(char *slot, char *response)
+{
+	fastboot_fail("Slot activation is not available", response);
+}
+
 /**
  * getvar() - Read a config/version variable
  *
diff --git a/drivers/fastboot/fb_getvar.c b/drivers/fastboot/fb_getvar.c
index e8aa0e09..89f76ed3 100644
--- a/drivers/fastboot/fb_getvar.c
+++ b/drivers/fastboot/fb_getvar.c
@@ -193,10 +193,14 @@ static void getvar_platform(char *var_parameter, char *response)
 		fastboot_fail("platform not set", response);
 }
 
+__weak void fastboot_get_current_slot(char *response)
+{
+	fastboot_fail("Persistent slot state is not available", response);
+}
+
 static void getvar_current_slot(char *var_parameter, char *response)
 {
-	/* A/B not implemented, for now always return "a" */
-	fastboot_okay("a", response);
+	fastboot_get_current_slot(response);
 }
 
 static void __maybe_unused getvar_has_slot(char *part_name, char *response)
diff --git a/drivers/usb/gadget/dwc2_udc_otg.c b/drivers/usb/gadget/dwc2_udc_otg.c
index 570fed34..01a8ab22 100644
--- a/drivers/usb/gadget/dwc2_udc_otg.c
+++ b/drivers/usb/gadget/dwc2_udc_otg.c
@@ -117,7 +117,7 @@ static void stop_activity(struct dwc2_udc *dev,
 			  struct usb_gadget_driver *driver);
 static int udc_enable(struct dwc2_udc *dev);
 static void udc_set_address(struct dwc2_udc *dev, unsigned char address);
-static void reconfig_usbd(struct dwc2_udc *dev);
+static int reconfig_usbd(struct dwc2_udc *dev);
 static void set_max_pktsize(struct dwc2_udc *dev, enum usb_device_speed speed);
 static void nuke(struct dwc2_ep *ep, int status);
 static int dwc2_udc_set_halt(struct usb_ep *_ep, int value);
@@ -224,10 +224,16 @@ static void udc_reinit(struct dwc2_udc *dev)
  */
 static int udc_enable(struct dwc2_udc *dev)
 {
+	int ret;
+
 	debug_cond(DEBUG_SETUP != 0, "%s: %p\n", __func__, dev);
 
 	otg_phy_init(dev);
-	reconfig_usbd(dev);
+	ret = reconfig_usbd(dev);
+	if (ret) {
+		otg_phy_off(dev);
+		return ret;
+	}
 
 	debug_cond(DEBUG_SETUP != 0,
 		   "DWC2 USB 2.0 OTG Controller Core Initialized : 0x%x\n",
@@ -289,7 +295,14 @@ int usb_gadget_register_driver(struct usb_gadget_driver *driver)
 
 	debug_cond(DEBUG_SETUP != 0,
 		   "Registered gadget driver %s\n", dev->gadget.name);
-	udc_enable(dev);
+	retval = udc_enable(dev);
+	if (retval) {
+		disable_irq(IRQ_OTG);
+		if (driver->unbind)
+			driver->unbind(&dev->gadget);
+		dev->driver = NULL;
+		return retval;
+	}
 
 	return 0;
 }
@@ -461,16 +474,18 @@ static void stop_activity(struct dwc2_udc *dev,
 	udc_reinit(dev);
 }
 
-static void reconfig_usbd(struct dwc2_udc *dev)
+static int reconfig_usbd(struct dwc2_udc *dev)
 {
 	/* 2. Soft-reset OTG Core and then unreset again. */
-	int i;
+	int i, ret;
 	u32 dflt_gusbcfg;
 	u32 rx_fifo_sz, tx_fifo_sz, np_tx_fifo_sz;
 	u32 max_hw_ep;
 	int pdata_hw_ep;
 
-	dwc2_core_reset(reg);
+	ret = dwc2_core_reset(reg);
+	if (ret)
+		return ret;
 
 	debug("Resetting OTG controller\n");
 
@@ -583,6 +598,7 @@ static void reconfig_usbd(struct dwc2_udc *dev)
 
 	/* 14. Initialize OTG Link Core.*/
 	writel(GAHBCFG_INIT, &reg->global_regs.gahbcfg);
+	return 0;
 }
 
 static void set_max_pktsize(struct dwc2_udc *dev, enum usb_device_speed speed)
