Subject: [PATCH] nand: permit BCH subpage reads in the isolated H432B experiment

Upstream-Status: Inappropriate [H432B RAM-only performance qualification]

nand_scan_tail installs the existing ECC-correcting subpage callback for BCH.
Permit its use without enabling subpage writes or changing parity layout.

--- a/include/linux/mtd/nand.h
+++ b/include/linux/mtd/nand.h
@@ -204,8 +204,14 @@
 #define NAND_HAS_CACHEPROG(chip) ((chip->options & NAND_CACHEPRG))
 #define NAND_HAS_COPYBACK(chip) ((chip->options & NAND_COPYBACK))
 /* Large page NAND with SOFT_ECC should support subpage reads */
+#ifdef CONFIG_U2_NAND_SUBPAGE
+#define NAND_SUBPAGE_READ(chip) \
+ (((chip)->ecc.mode == NAND_ECC_SOFT || \
+   (chip)->ecc.mode == NAND_ECC_SOFT_BCH) && (chip)->page_shift > 9)
+#else
 #define NAND_SUBPAGE_READ(chip) ((chip->ecc.mode == NAND_ECC_SOFT) \
 					&& (chip->page_shift > 9))
+#endif
 
 /* Non chip related options */
