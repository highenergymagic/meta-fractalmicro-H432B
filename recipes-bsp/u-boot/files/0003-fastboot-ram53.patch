 U_BOOT_CMD(u2linux,1,0,do_u2linux,"boot the three verified RAM images","");
 
+int u2_fastboot_linux(const struct u2_fb_image *image)
+{
+ const u8 *p=(const u8 *)U2_FB_ADDRESS;
+ unsigned i;
+ unsigned offsets[3]={image->kernel,image->dtb,image->ramdisk};
+ unsigned sizes[3]={image->kernel_size,image->dtb_size,image->ramdisk_size};
+ for(i=0;i<3;i++) {
+  memcpy((void *)u2_ram_address[i],p+offsets[i],sizes[i]);
+  slots[i].size=slots[i].received=sizes[i];
+  slots[i].actual_crc=slots[i].expected_crc=
+   crc32(0,(void *)u2_ram_address[i],sizes[i]);
+  slots[i].state=U2_RAM_VALID;
+ }
+ return do_u2linux(NULL,0,1,NULL);
+}
+
 void u2probe_poll(void) {
  usb_gadget_handle_interrupts();
+ u2fastboot_poll();
  if (slots[selected].state==U2_RAM_VERIFY)
   u2_ram_checked(&slots[selected],crc32(0,(void *)u2_ram_address[selected],slots[selected].size));
  if (command_state==1) {
