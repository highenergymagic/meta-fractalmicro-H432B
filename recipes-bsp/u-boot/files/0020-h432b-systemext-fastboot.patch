diff --git a/board/fractalmicro/h432b/mmc-update.c b/board/fractalmicro/h432b/mmc-update.c
--- /dev/null
+++ b/board/fractalmicro/h432b/mmc-update.c
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Slot image I/O only. Provisioning and userdata are not fastboot targets. */
+#include <dm.h>
+#include <malloc.h>
+#include <mmc.h>
+#include <asm/cache.h>
+#include <u-boot/sha256.h>
+#include <u-boot/schedule.h>
+#include "mmc-update.h"
+#include "slot-pair.h"
+
+#define EXTENSION_SECTORS 4194304ULL
+#define IO_BYTES (64U * 1024U)
+
+int h432b_extension_open(unsigned int slot, struct h432b_extension *extension)
+{
+	static const char *const labels[] = {
+		"systemext_A", "systemext_B", "cache", "userdata",
+	};
+	static const lbaint_t starts[] = { 2048, 4196352, 8390656, 16779264 };
+	static const lbaint_t sizes[] = { EXTENSION_SECTORS, EXTENSION_SECTORS, 8388608 };
+	struct udevice *dev, *block;
+	struct mmc *mmc;
+	struct disk_partition part;
+	struct blk_desc *disk;
+	unsigned int i;
+
+	/* find_mmc_device() only returns an already active controller in DM.
+	 * NAND autoboot never probes MMC, so explicitly probe the board's alias.
+	 */
+	if (slot > 1 || uclass_get_device_by_seq(UCLASS_MMC, 0, &dev))
+		return -ENODEV;
+	mmc = mmc_get_mmc_dev(dev);
+	if (!mmc || !mmc->dev || dev_read_addr(mmc->dev) != 0xeb100000)
+		return -EXDEV;
+	/* The block child's post-probe performs partition discovery in DM.
+	 * mmc_init() alone only enumerates the card and leaves part_type unknown.
+	 */
+	if (blk_get_device(UCLASS_MMC, 0, &block) || dev_get_parent(block) != dev)
+		return -EIO;
+	disk = mmc_get_blk_desc(mmc);
+	if (disk->blksz != 512 || disk->part_type != PART_TYPE_EFI)
+		return -EPROTONOSUPPORT;
+	if (disk->lba < starts[3] + 2097152 + 33)
+		return -ENOSPC;
+	/* Validate the complete v1 layout, not just a plausible partition name.
+	 * Explicit EFI lookup rejects DOS tables; upstream verifies GPT CRCs.
+	 */
+	for (i = 0; i < ARRAY_SIZE(labels); i++) {
+		if (part_get_info_by_type(disk, i + 1, PART_TYPE_EFI, &part) ||
+		    strcmp(part.name, labels[i]) || part.blksz != 512 ||
+		    part.start != starts[i] ||
+		    (i < 3 && part.size != sizes[i]) ||
+		    (i == 3 && (part.size < 2097152 ||
+				part.size > disk->lba - 33 - starts[i] ||
+				disk->lba - 33 - starts[i] - part.size >= 2048)))
+			return -EINVAL;
+		if (i == slot)
+			extension->partition = part;
+	}
+	/* No additional named entries are part of this layout. */
+	for (i = 5; i <= 128; i++) {
+		if (!part_get_info_by_type(disk, i, PART_TYPE_EFI, &part))
+			return -EINVAL;
+	}
+	extension->disk = disk;
+	return 0;
+}
+
+int h432b_extension_image(const void *buffer, u32 size)
+{
+	const u8 *bytes = buffer;
+
+	/* Raw EROFS + verity only. Sparse downloads need a separate bounded
+	 * parser before enabling upstream sparse expansion on this backend.
+	 */
+	if (size < 8192 || size % 4096 || size > 0x80000000U ||
+	    memcmp(bytes + 1024, "\xe2\xe1\xf5\xe0", 4))
+		return -EINVAL;
+	return 0;
+}
+
+int h432b_extension_write(struct h432b_extension *extension,
+			   const void *buffer, u32 size)
+{
+	struct blk_desc *disk = extension->disk;
+	lbaint_t start = extension->partition.start, count;
+	u8 expected[SHA256_SUM_LEN], actual[SHA256_SUM_LEN];
+	sha256_context ctx;
+	u8 *scratch;
+	u32 offset, length;
+	int ret = -EIO;
+
+	if (h432b_extension_image(buffer, size) ||
+	    size / 512 > extension->partition.size)
+		return -EINVAL;
+	scratch = memalign(ARCH_DMA_MINALIGN, IO_BYTES);
+	if (!scratch)
+		return -ENOMEM;
+	sha256_csum_wd(buffer, size, expected, CHUNKSZ_SHA256);
+	for (offset = 0; offset < size; offset += length) {
+		length = min_t(u32, size - offset, IO_BYTES);
+		count = length / 512;
+		if (blk_dwrite(disk, start + offset / 512, count,
+			       (const u8 *)buffer + offset) != count)
+			goto out;
+		schedule();
+	}
+	/* Do not use cached block reads as evidence of physical readback. */
+	blkcache_invalidate(disk->uclass_id, disk->devnum);
+	sha256_starts(&ctx);
+	for (offset = 0; offset < size; offset += length) {
+		length = min_t(u32, size - offset, IO_BYTES);
+		count = length / 512;
+		if (blk_dread(disk, start + offset / 512, count, scratch) != count)
+			goto out;
+		sha256_update(&ctx, scratch, length);
+		schedule();
+	}
+	sha256_finish(&ctx, actual);
+	ret = memcmp(expected, actual, sizeof(expected)) ? -EIO : 0;
+out:
+	free(scratch);
+	return ret;
+}
+
+static int extension_read(void *context, unsigned int block, u8 *buffer)
+{
+	struct h432b_extension *extension = context;
+	lbaint_t sector = (lbaint_t)block * 8;
+
+	if (sector + 8 > extension->partition.size ||
+	    blk_dread(extension->disk, extension->partition.start + sector,
+		      8, buffer) != 8)
+		return -EIO;
+	schedule();
+	return 0;
+}
+
+static void extension_hash(const u8 *salt, const u8 *block, u8 *digest)
+{
+	sha256_context ctx;
+
+	sha256_starts(&ctx);
+	sha256_update(&ctx, salt, 32);
+	sha256_update(&ctx, block, 4096);
+	sha256_finish(&ctx, digest);
+	schedule();
+}
+
+int h432b_extension_verify(unsigned int slot, const struct h432b_verity *verity)
+{
+	struct h432b_extension extension;
+	u8 *workspace;
+	int ret;
+
+	ret = h432b_extension_open(slot, &extension);
+	if (ret)
+		return ret;
+	workspace = memalign(ARCH_DMA_MINALIGN, 8192);
+	if (!workspace)
+		return -ENOMEM;
+	ret = h432b_verity_stream(verity, &extension, extension_read,
+				 extension_hash, workspace);
+	free(workspace);
+	return ret;
+}
diff --git a/board/fractalmicro/h432b/mmc-update.h b/board/fractalmicro/h432b/mmc-update.h
--- /dev/null
+++ b/board/fractalmicro/h432b/mmc-update.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef H432B_MMC_UPDATE_H
+#define H432B_MMC_UPDATE_H
+
+#include <blk.h>
+#include <part.h>
+
+struct h432b_verity;
+
+struct h432b_extension {
+	struct blk_desc *disk;
+	struct disk_partition partition;
+};
+
+int h432b_extension_open(unsigned int slot, struct h432b_extension *extension);
+int h432b_extension_image(const void *buffer, u32 size);
+int h432b_extension_write(struct h432b_extension *extension,
+			   const void *buffer, u32 size);
+int h432b_extension_verify(unsigned int slot, const struct h432b_verity *verity);
+
+#endif
