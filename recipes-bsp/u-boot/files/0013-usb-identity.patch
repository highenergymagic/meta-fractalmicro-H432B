Subject: [PATCH] H432B use explicit maintenance branding and factory-derived ID

Upstream-Status: Inappropriate [board-specific factory handoff]

Use the validated factory-MAC-derived board identifier consistently in USB
descriptors and fastboot. Omit the USB serial if no valid handoff exists;
the identifier is not a verified manufacturer serial number.

--- a/board/hims/u2/u2probe.c
+++ b/board/hims/u2/u2probe.c
@@ -14,6 +14,7 @@
 extern int u2fastboot_configure(struct usb_gadget *, unsigned);
 extern void u2fastboot_disable(void);
 extern void u2fastboot_poll(void);
+extern const char *u2_identity_board_id(void);

 /* USB control-only diagnostic shell.  Commands can change hardware state. */
 #define U2_USB_OTG      0xec000000UL
@@ -67,7 +68,10 @@
 static const u8 lang[] = {4,USB_DT_STRING,0x09,0x04};
 static const u8 qualifier[] = {10,USB_DT_DEVICE_QUALIFIER,0x00,0x02,
  USB_CLASS_VENDOR_SPEC,0,0,64,1,0};
-static const char *strings[] = {"U2 Open","BrailleSense U2 probe","diagnostic command interface","OPENH432-FASTBOOT","H432B fastboot"};
+static const char *strings[] = {
+ "Fractal Microsystems", "Braille Sense U2 (Maintenance)",
+ "maintenance command interface", "", "H432B fastboot"
+};
 static void completed(struct usb_ep *ep, struct usb_request *r) {
  unsigned n;
  if (receiving_ram) {
@@ -186,6 +190,9 @@
 }
 static int bind(struct usb_gadget *g) {
  int rc;
+ const char *id=u2_identity_board_id();
+ strings[3]=id ? id : "";
+ dev.iSerialNumber=id ? 4 : 0;
  req=usb_ep_alloc_request(g->ep0,0);
  if (!req)return -ENOMEM;
  req->complete=completed;
