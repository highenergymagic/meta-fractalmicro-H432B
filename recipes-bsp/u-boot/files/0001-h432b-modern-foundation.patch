 	select OF_CONTROL
@@ -21,5 +27,6 @@ config SYS_SOC
 
 source "board/samsung/goni/Kconfig"
 source "board/samsung/smdkc100/Kconfig"
+source "board/fractalmicro/h432b/Kconfig"
 
 endif
