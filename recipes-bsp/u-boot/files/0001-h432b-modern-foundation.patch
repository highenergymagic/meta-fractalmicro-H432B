Subject: [PATCH] arm: add H432B RAM-entry board foundation

Upstream-Status: Pending

Keep the factory-initialized clock tree and DRAM, and use the H432B PWM4
clocksource. USB and storage integration are intentionally not enabled in
this compile-only foundation target.

diff --git a/arch/arm/cpu/armv7/s5p-common/Makefile b/arch/arm/cpu/armv7/s5p-common/Makefile
index 4660ff00..7634c61d 100644
--- a/arch/arm/cpu/armv7/s5p-common/Makefile
+++ b/arch/arm/cpu/armv7/s5p-common/Makefile
@@ -9,7 +9,9 @@ obj-$(CONFIG_S5P4418_ONEWIRE) += pwm.o
 else
 obj-y += cpu_info.o
 ifndef CONFIG_XPL_BUILD
+ifndef CONFIG_TARGET_H432B
 obj-y += timer.o
+endif
 obj-y += sromc.o
 endif
 endif
