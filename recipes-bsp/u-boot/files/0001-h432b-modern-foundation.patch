index d8b85f80..7684b19b 100644
--- a/arch/arm/mach-s5pc1xx/Kconfig
+++ b/arch/arm/mach-s5pc1xx/Kconfig
@@ -4,6 +4,12 @@ choice
 	prompt "S5PC1XX board select"
