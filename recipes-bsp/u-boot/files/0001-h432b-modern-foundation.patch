 dtb-$(CONFIG_TARGET_S5P_GONI) += s5pc1xx-goni.dtb
+dtb-$(CONFIG_TARGET_H432B) += s5pv210-h432b.dtb
 dtb-$(CONFIG_ARCH_EXYNOS4) += exynos4210-origen.dtb \
 	exynos4210-smdkv310.dtb \
 	exynos4210-universal_c210.dtb \
diff --git a/arch/arm/dts/s5pv210-h432b.dts b/arch/arm/dts/s5pv210-h432b.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm/dts/s5pv210-h432b.dts
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/dts-v1/;
+
+/ {
+	model = "Fractal Microsystems H432B";
+	compatible = "hims,h432b", "samsung,s5pv210";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x10000000>;
+	};
+};
