+
+#include <asm/arch/cpu.h>
+
+#define CFG_SYS_SDRAM_BASE 0x40000000
+#define CFG_SYS_SDRAM_SIZE 0x10000000
+
+#endif
diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
