diff --git a/rev51/board/hims/u2/lowlevel_init.S b/board/hims/u2/lowlevel_init.S
new file mode 100644
index 0000000..d2fbca6
--- /dev/null
+++ b/board/hims/u2/lowlevel_init.S
@@ -0,0 +1,8 @@
+/*
+ * EBOOT has already initialized S5PV210 clocks and 256 MiB DDR before the
+ * B000FF launch entry.  Do not replay another Samsung board's reset-time DMC
+ * or PMIC sequence from an NK payload.
+ */
+	.globl lowlevel_init
+lowlevel_init:
+	mov	pc, lr
diff --git a/rev51/board/hims/u2/u2.c b/board/hims/u2/u2.c
new file mode 100644
index 0000000..bef8319
--- /dev/null
+++ b/board/hims/u2/u2.c
@@ -0,0 +1,240 @@
+/*
+ * HIMS BrailleSense U2 board support.
+ *
+ * OEMLaunch disables the MMU and enters the physical DRAM address selected
+ * by the B000FF trailer. Keep the first boot probe in physical address space.
+ */
+#include <common.h>
+#include <command.h>
+#include <asm/io.h>
+#include <asm/mach-types.h>
+#include "u2_braille.h"
+extern int u2probe_start(void);
+extern void u2probe_poll(void);
+
+
+#define U2_NAND_BASE 0xb0e00000UL
+#define U2_NFCONT (U2_NAND_BASE + 0x04)
+#define U2_NFCMD  (U2_NAND_BASE + 0x08)
+#define U2_NFADDR (U2_NAND_BASE + 0x0c)
+#define U2_NFDATA (U2_NAND_BASE + 0x10)
+#define U2_NFSTAT (U2_NAND_BASE + 0x28)
+
+DECLARE_GLOBAL_DATA_PTR;
+
+int board_init(void)
+{
+	/* Inherited, already-powered display. A refused update must not
+	 * prevent boot or the USB shell from starting. No rail changes. */
+	(void)u2_braille_brf(U2_BRAILLE_BRAND_BRF);
+	/* Legacy tag only; production Linux boots with the U2 device tree. */
+	gd->bd->bi_arch_number = MACH_TYPE_SMDKV210;
+	gd->bd->bi_boot_params = CONFIG_SYS_SDRAM_BASE + 0x100;
+	return 0;
+}
+
+/* Called only when bootm is about to load a validated Linux OS image.
+ * Exposed through `u2 braille kernel` for display-only verification. */
+void u2_braille_kernel_start(void)
+{
+	(void)u2_braille_brf(U2_BRAILLE_KERNEL_BRF);
+}
+
+int dram_init(void)
+{
+	gd->ram_size = CONFIG_SYS_SDRAM_SIZE;
+	return 0;
+}
+
+void dram_init_banksize(void)
+{
+	gd->bd->bi_dram[0].start = CONFIG_SYS_SDRAM_BASE;
+	gd->bd->bi_dram[0].size = CONFIG_SYS_SDRAM_SIZE;
+}
+
+int checkboard(void)
+{
+	puts("Board: HIMS BrailleSense U2 (EBOOT payload)\\n");
+	return 0;
+}
+
+/* Only the three proven USB register addresses are exposed to the probe. */
+int u2_eboot_phys_to_virt(u32 phys, u32 *virt)
+{
+	if (phys != 0xec000000 && phys != 0xec100000 &&
+	    phys != 0xe010e80c)
+		return -1;
+	*virt = phys;
+	return 0;
+}
+
+/* Read only the first eight bytes of a physical NAND page. This intentionally
+ * has no program, erase, ECC, or bad-block-table operations. */
+static int u2_nand_page_head(u32 page, u8 head[8])
+{
+	unsigned i;
+
+	writeb(0x00, U2_NFCMD);
+	writeb(0x00, U2_NFADDR);
+	writeb(0x00, U2_NFADDR);
+	writeb(page & 0xff, U2_NFADDR);
+	writeb((page >> 8) & 0xff, U2_NFADDR);
+	writeb((page >> 16) & 0xff, U2_NFADDR);
+	writeb(0x30, U2_NFCMD);
+	for (i = 0; i < 100000; i++) {
+		if (readl(U2_NFSTAT) & 1)
+			break;
+		udelay(1);
+	}
+	if (i == 100000)
+		return -1;
+	for (i = 0; i < 8; i++)
+		head[i] = readb(U2_NFDATA);
+	return 0;
+}
+
+static int u2_nand_scan(unsigned first, unsigned count)
+{
+	u32 original = readl(U2_NFCONT);
+	unsigned block;
+	u8 head[8];
+	int result = 0;
+
+	if (!(original & 1) || first >= 4096 || !count || count > 4096 - first) {
+		printf("NAND scan rejected: NFCONT=%08x first=%u count=%u\n",
+		       original, first, count);
+		return CMD_RET_FAILURE;
+	}
+	writel(original & ~2, U2_NFCONT); /* select NAND chip; preserve all else */
+	for (block = first; block < first + count; block++) {
+		if (u2_nand_page_head(block * 64, head)) {
+			printf("NAND read timeout at physical block %u\n", block);
+			result = CMD_RET_FAILURE;
+			break;
+		}
+		if (!memcmp(head, "B000FF\n", 7) ||
+		    !memcmp(head, "\x14\x00\x00\xea\x14\xf0\x9f\xe5", 8))
+			printf("candidate block %u page %u: %02x %02x %02x %02x "
+			       "%02x %02x %02x %02x\n", block, block * 64,
+			       head[0], head[1], head[2], head[3],
+			       head[4], head[5], head[6], head[7]);
+	}
+	writel(original, U2_NFCONT);
+	printf("NAND first-page scan: %u blocks examined; NFCONT restored %08x\n",
+	       block - first, original);
+	return result;
+}
+
+static int u2_nand_pages(unsigned first, unsigned count)
+{
+	u32 original = readl(U2_NFCONT);
+	unsigned page;
+	u8 head[8];
+	int result = 0;
+
+	if (!(original & 1) || first >= 262144 || !count ||
+	    count > 262144 - first) {
+		printf("NAND page scan rejected: NFCONT=%08x first=%u count=%u\n",
+		       original, first, count);
+		return CMD_RET_FAILURE;
+	}
+	writel(original & ~2, U2_NFCONT);
+	for (page = first; page < first + count; page++) {
+		if (u2_nand_page_head(page, head)) {
+			printf("NAND read timeout at physical page %u\n", page);
+			result = CMD_RET_FAILURE;
+			break;
+		}
+		if (!memcmp(head, "B000FF\n", 7) ||
+		    !memcmp(head, "\x14\x00\x00\xea\x14\xf0\x9f\xe5", 8))
+			printf("candidate page %u block %u: %02x %02x %02x %02x "
+			       "%02x %02x %02x %02x\n", page, page / 64,
+			       head[0], head[1], head[2], head[3],
+			       head[4], head[5], head[6], head[7]);
+	}
+	writel(original, U2_NFCONT);
+	printf("NAND page scan: %u pages examined; NFCONT restored %08x\n",
+	       page - first, original);
+	return result;
+}
+
+static int u2_nand_head(unsigned page)
+{
+	u32 original = readl(U2_NFCONT);
+	u8 head[8];
+	int result;
+
+	if (!(original & 1) || page >= 262144)
+		return CMD_RET_FAILURE;
+	writel(original & ~2, U2_NFCONT);
+	result = u2_nand_page_head(page, head);
+	writel(original, U2_NFCONT);
+	if (result)
+		return CMD_RET_FAILURE;
+	printf("physical NAND page %u block %u: %02x %02x %02x %02x "
+	       "%02x %02x %02x %02x\n", page, page / 64,
+	       head[0], head[1], head[2], head[3],
+	       head[4], head[5], head[6], head[7]);
+	return 0;
+}
+
+static int do_u2(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+	if (argc == 3 && !strcmp(argv[1], "braille")) {
+		int result;
+
+		if (!strcmp(argv[2], "brand"))
+			result = u2_braille_brf(U2_BRAILLE_BRAND_BRF);
+		else if (!strcmp(argv[2], "kernel"))
+			result = u2_braille_brf(U2_BRAILLE_KERNEL_BRF);
+		else
+			return CMD_RET_USAGE;
+		printf("Braille %s frame: %s (status %d)\n", argv[2],
+		       result ? "not sent" : "sent", result);
+		return result ? CMD_RET_FAILURE : 0;
+	}
+	if (argc == 3 && !strcmp(argv[1], "map")) {
+		u32 phys = simple_strtoul(argv[2], NULL, 16);
+		u32 virt;
+
+		if (u2_eboot_phys_to_virt(phys, &virt)) {
+			printf("U2 has no whitelisted physical register %08x\\n", phys);
+			return CMD_RET_FAILURE;
+		}
+		printf("U2 physical register: %08x\\n", virt);
+		return 0;
+	}
+
+	if (argc == 2 && !strcmp(argv[1], "probe")) {
+		if (u2probe_start())
+			/* Do not retry a failed USB initialization endlessly. */
+			for (;;)
+				;
+		while (1)
+			u2probe_poll();
+	}
+	if (argc == 4 && !strcmp(argv[1], "nand-scan")) {
+		unsigned first = simple_strtoul(argv[2], NULL, 0);
+		unsigned count = simple_strtoul(argv[3], NULL, 0);
+		return u2_nand_scan(first, count);
+	}
+	if (argc == 4 && !strcmp(argv[1], "nand-pages")) {
+		unsigned first = simple_strtoul(argv[2], NULL, 0);
+		unsigned count = simple_strtoul(argv[3], NULL, 0);
+		return u2_nand_pages(first, count);
+	}
+	if (argc == 3 && !strcmp(argv[1], "nand-head")) {
+		unsigned page = simple_strtoul(argv[2], NULL, 0);
+		return u2_nand_head(page);
+	}
+	return CMD_RET_USAGE;
+}
+
+U_BOOT_CMD(u2, 4, 0, do_u2,
+	"U2 board diagnostics",
+	"map <physical-hex> - show a whitelisted physical USB register\n"
+	"u2 braille brand|kernel - display the fixed Grade 2 status (no boot/power change)\n"
+	"u2 probe - start the USB control command interface\n"
+	"u2 nand-scan <first-block> <count> - scan NAND block first pages read-only\n"
+	"u2 nand-pages <first-page> <count> - scan all selected page heads read-only\n"
+	"u2 nand-head <page> - show eight bytes of one physical page");
diff --git a/rev51/board/hims/u2/u2_braille.h b/board/hims/u2/u2_braille.h
new file mode 100644
index 0000000..7b86861
--- /dev/null
+++ b/board/hims/u2/u2_braille.h
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef U2_BRAILLE_H
+#define U2_BRAILLE_H
+
+/* Recovered from CE brlcell.dll, C0E320F8. Transport only: no mux,
+ * regulator, Cell_On, PMIC, NAND or clock-controller writes. */
+#define U2_GPJ0CON 0xe0200240UL
+#define U2_GPJ0DAT 0xe0200244UL
+#define U2_GPJ1CON 0xe0200260UL
+#define U2_GPJ1DAT 0xe0200264UL
+#define U2_GPJ4CON 0xe02002c0UL
+#define U2_GPJ4DAT 0xe02002c4UL
+#define U2_BRL_DATA  0x20U
+#define U2_BRL_CLOCK 0x10U
+#define U2_BRL_LATCH 0x02U
+
+#ifndef U2_BRL_READ
+#define U2_BRL_READ(addr) (*(volatile unsigned int *)(addr))
+#define U2_BRL_WRITE(addr, value) do { \
+    *(volatile unsigned int *)(addr) = (value); \
+    __asm__ volatile("dsb sy" : : : "memory"); \
+    (void)U2_BRL_READ(addr); \
+} while (0)
+#endif
+
+/* Exact contracted Braille ASCII supplied by the user. These strings
+ * already contain the translation: do NOT run a text translator on them.
+ * Letter case is folded only when decoding six-dot Braille ASCII. */
+#define U2_BRAILLE_BRAND_BRF ",Fractal ,Microsy/ems"
+#define U2_BRAILLE_KERNEL_BRF ",/>t+ ,open;,h#dcb444"
+
+/* North American Braille ASCII, characters 0x20..0x5f -> standard dots.
+ * Dot-number mapping checked against the primary liblouis display table:
+ * https://github.com/liblouis/liblouis/blob/master/tables/en-us-brf.dis
+ * This is a display-code decoder, NOT a Grade 2 translator. */
+static const unsigned char u2_brf_dots[64] = {
+    0x00, 0x2e, 0x10, 0x3c, 0x2b, 0x29, 0x2f, 0x04,
+    0x37, 0x3e, 0x21, 0x2c, 0x20, 0x24, 0x28, 0x0c,
+    0x34, 0x02, 0x06, 0x12, 0x32, 0x22, 0x16, 0x36,
+    0x26, 0x14, 0x31, 0x30, 0x23, 0x3f, 0x1c, 0x39,
+    0x08, 0x01, 0x03, 0x09, 0x19, 0x11, 0x0b, 0x1b,
+    0x13, 0x0a, 0x1a, 0x05, 0x07, 0x0d, 0x1d, 0x15,
+    0x0f, 0x1f, 0x17, 0x0e, 0x1e, 0x25, 0x27, 0x3a,
+    0x2d, 0x3d, 0x35, 0x2a, 0x33, 0x3b, 0x18, 0x38
+};
+
+/* StepLoader bootimage.nb0 +0x7c0 emits the readable HIMS greeting using
+ * these CE-format bytes: H=4c I=84 M=8a S=86 a=08 l=0e cap=20.
+ * Together they determine dots 1..6 = 08 04 02 80 40 20. All remaining
+ * greeting symbols agree. Dot 7/8 mapping is NOT yet established. */
+static unsigned char u2_braille_sixdot_cell(unsigned char dots)
+{
+    return ((dots & 0x01U) << 3) | ((dots & 0x02U) << 1) |
+           ((dots & 0x04U) >> 1) | ((dots & 0x08U) << 4) |
+           ((dots & 0x10U) << 2) | (dots & 0x20U);
+}
+
+/* Internal transport accepts CE-format bytes, NOT standard dot masks. */
+static int u2_braille_ce_frame(const unsigned char frame[32])
+{
+    int cell, bit;
+    unsigned int value, wire;
+
+    /* Only reuse a live EBOOT-configured display; do not enable one. */
+    if ((U2_BRL_READ(U2_GPJ0CON) & 0xf000U) != 0x1000U ||
+        (U2_BRL_READ(U2_GPJ1CON) & 0xff0000U) != 0x110000U ||
+        (U2_BRL_READ(U2_GPJ4CON) & 0xf0U) != 0x10U)
+        return 1;
+    if (!(U2_BRL_READ(U2_GPJ0DAT) & 8U))
+        return 2;
+    if (U2_BRL_READ(U2_GPJ1DAT) & U2_BRL_CLOCK)
+        return 3;
+
+    value = U2_BRL_READ(U2_GPJ4DAT) & ~U2_BRL_LATCH;
+    U2_BRL_WRITE(U2_GPJ4DAT, value);
+    for (cell = 31; cell >= 0; --cell) {
+        /* CE reverses the polarity at odd MSB-first bit indices. */
+        wire = frame[cell] ^ 0x55U;
+        for (bit = 7; bit >= 0; --bit) {
+            value = U2_BRL_READ(U2_GPJ1DAT) & ~U2_BRL_DATA;
+            if (wire & (1U << bit))
+                value |= U2_BRL_DATA;
+            U2_BRL_WRITE(U2_GPJ1DAT, value);
+            value = U2_BRL_READ(U2_GPJ1DAT) | U2_BRL_CLOCK;
+            U2_BRL_WRITE(U2_GPJ1DAT, value);
+            value = U2_BRL_READ(U2_GPJ1DAT) & ~U2_BRL_CLOCK;
+            U2_BRL_WRITE(U2_GPJ1DAT, value);
+        }
+    }
+    value = U2_BRL_READ(U2_GPJ4DAT) | U2_BRL_LATCH;
+    U2_BRL_WRITE(U2_GPJ4DAT, value);
+    value = U2_BRL_READ(U2_GPJ4DAT) & ~U2_BRL_LATCH;
+    U2_BRL_WRITE(U2_GPJ4DAT, value);
+    return 0;
+}
+
+static int u2_braille_sixdot_frame(const unsigned char dots[32])
+{
+    unsigned char frame[32];
+    unsigned int cell;
+
+    for (cell = 0; cell < 32; ++cell) {
+        if (dots[cell] & 0xc0U)
+            return 5; /* No guessed dot-7/dot-8 mapping; no GPIO writes. */
+        frame[cell] = u2_braille_sixdot_cell(dots[cell]);
+    }
+    return u2_braille_ce_frame(frame);
+}
+
+/* Reject unsupported/overlength input before any GPIO writes. Blank-pad
+ * all unused cells so a shorter status replaces the previous full line. */
+static int u2_braille_brf_decode(const char *brf, unsigned char dots[32])
+{
+    unsigned int cell = 0;
+    unsigned char ch;
+
+    while (*brf) {
+        if (cell == 32)
+            return 7;
+        ch = (unsigned char)*brf++;
+        if (ch >= 'a' && ch <= 'z')
+            ch -= 'a' - 'A';
+        if (ch < 0x20 || ch > 0x5f)
+            return 6;
+        dots[cell++] = u2_brf_dots[ch - 0x20];
+    }
+    while (cell < 32)
+        dots[cell++] = 0;
+    return 0;
+}
+
+static int u2_braille_brf(const char *brf)
+{
+    unsigned char dots[32];
+    int result = u2_braille_brf_decode(brf, dots);
+
+    if (result)
+        return result;
+    return u2_braille_sixdot_frame(dots);
+}
+#endif
diff --git a/rev51/board/hims/u2/u2probe.c b/board/hims/u2/u2probe.c
new file mode 100644
index 0000000..fc3e4c3
--- /dev/null
+++ b/board/hims/u2/u2probe.c
@@ -0,0 +1,143 @@
+#include <common.h>
+#include <asm/io.h>
+#include <asm/errno.h>
+#include <linux/usb/ch9.h>
+#include <usbdescriptors.h>
+#include <linux/usb/gadget.h>
+#include <usb/s3c_udc.h>
+#include <command.h>
+
+/* USB control-only diagnostic shell.  Commands can change hardware state. */
+#define U2_USB_OTG      0xec000000UL
+#define U2_USB_PHY      0xec100000UL
+#define U2_USB_CTRL     0xe010e80cUL
+#define U2_USB_CLK_GATE 0xe0100464UL
+extern int u2_eboot_phys_to_virt(u32 phys, u32 *virt);
+static struct usb_request *req;
+static u8 reply[64];
+static u8 configured;
+static u8 command_rx[64];
+static char command_text[64];
+static char command_output[4096];
+static unsigned output_len;
+static unsigned command_state; /* 0 idle, 1 queued, 2 running, 3 complete */
+static int command_result;
+static int receiving_command;
+static int output_truncated;
+
+void u2_console_append(char c)
+{
+ if (output_len < sizeof(command_output))
+  command_output[output_len++] = c;
+ else
+  output_truncated = 1;
+}
+static struct usb_device_descriptor dev = {
+ .bLength=18,.bDescriptorType=USB_DT_DEVICE,.bcdUSB=cpu_to_le16(0x0200),
+ .bDeviceClass=USB_CLASS_VENDOR_SPEC,.bMaxPacketSize0=64,
+ .idVendor=cpu_to_le16(0x1d50),.idProduct=cpu_to_le16(0x6152),
+ .bcdDevice=cpu_to_le16(1),.iManufacturer=1,.iProduct=2,.bNumConfigurations=1,
+};
+static const u8 cfg[] = {9,USB_DT_CONFIG,18,0,1,1,0,0x80,50,
+ 9,USB_DT_INTERFACE,0,0,0,USB_CLASS_VENDOR_SPEC,0,0,3};
+static const u8 lang[] = {4,USB_DT_STRING,0x09,0x04};
+static const u8 qualifier[] = {10,USB_DT_DEVICE_QUALIFIER,0x00,0x02,
+ USB_CLASS_VENDOR_SPEC,0,0,64,1,0};
+static const char *strings[] = {"U2 Open","BrailleSense U2 probe","diagnostic command interface"};
+static void completed(struct usb_ep *ep, struct usb_request *r) {
+ unsigned n;
+ if (!receiving_command) return;
+ receiving_command=0;
+ if (r->status || !r->actual || r->actual > sizeof(command_rx)) return;
+ n=r->actual;
+ memcpy(command_text,command_rx,n);
+ if (command_text[n-1] == 0) n--;
+ command_text[n]=0;
+ if (n) command_state=1;
+}
+static int send(struct usb_gadget *g, const void *p, unsigned n) {
+ /* Avoid an exact EP0 max-packet data stage: this UDC expects an extra ZLP. */
+ if (n > 63) n=63;
+ if (n && p != reply) memcpy(reply,p,n);
+ req->buf=reply; req->length=n; req->zero=0;
+ return usb_ep_queue(g->ep0,req,0);
+}
+static int setup(struct usb_gadget *g,const struct usb_ctrlrequest *r) {
+ u16 wv=le16_to_cpu(r->wValue), wi=le16_to_cpu(r->wIndex), wl=le16_to_cpu(r->wLength); u8 t=r->bRequestType;
+ if (t==0x80 && r->bRequest==USB_REQ_GET_DESCRIPTOR) {
+  if ((wv>>8)==USB_DT_DEVICE) return send(g,&dev,min((unsigned)wl,(unsigned)sizeof(dev)));
+  if ((wv>>8)==USB_DT_CONFIG) return send(g,cfg,min((unsigned)wl,(unsigned)sizeof(cfg)));
+  if ((wv>>8)==USB_DT_DEVICE_QUALIFIER) return send(g,qualifier,min((unsigned)wl,(unsigned)sizeof(qualifier)));
+  if ((wv>>8)==USB_DT_STRING) { unsigned i=wv&255,j,n; if(!i) return send(g,lang,min((unsigned)wl,4U)); if(i>3)return -EINVAL; n=2+2*strlen(strings[i-1]); reply[0]=n;reply[1]=USB_DT_STRING; for(j=0;j<n-2;j+=2){reply[2+j]=strings[i-1][j/2];reply[3+j]=0;} return send(g,reply,min((unsigned)wl,n)); }
+ }
+ if (t==0x00 && r->bRequest==USB_REQ_SET_CONFIGURATION && wv<=1) {
+  configured=wv; return send(g,reply,0);
+ }
+ if (t==0x80 && r->bRequest==USB_REQ_GET_CONFIGURATION) {
+  return send(g,&configured,min((unsigned)wl,1U));
+ }
+ if (t==0x01 && r->bRequest==USB_REQ_SET_INTERFACE && wv==0) return send(g,reply,0);
+ if (t==0x81 && r->bRequest==USB_REQ_GET_INTERFACE) {
+  static const u8 alt=0; return send(g,&alt,min((unsigned)wl,1U));
+ }
+ if (t==0xc0 && r->bRequest==0x51) { static const u8 x[]={'U','2','P','R','O','B','E',51,0,2,0,0}; return send(g,x,min((unsigned)wl,(unsigned)sizeof(x))); }
+ /* Diagnostic shell: OUT command, then IN status and output slices.
+  * Magic guards against accidental requests; it is not authentication. */
+ if (t==0x40 && r->bRequest==0x52 && wv==0x3255 && wi==0x4f50 &&
+     wl>0 && wl<sizeof(command_rx) && command_state!=1 && command_state!=2) {
+  command_state=0; receiving_command=1;
+  req->buf=command_rx; req->length=wl; req->zero=0;
+  return usb_ep_queue(g->ep0,req,0);
+ }
+ if (t==0xc0 && r->bRequest==0x53) {
+  u8 status[12]={'U','2','C','S',0,0,0,0,0,0,0,0};
+  status[4]=command_state;
+  status[5]=output_truncated;
+  status[6]=command_result & 255;
+  status[7]=(command_result >> 8) & 255;
+  status[8]=output_len & 255;
+  status[9]=(output_len >> 8) & 255;
+  return send(g,status,min((unsigned)wl,(unsigned)sizeof(status)));
+ }
+ if (t==0xc0 && r->bRequest==0x54 && command_state==3) {
+  if (wv>=output_len) return send(g,reply,0);
+  return send(g,command_output+wv,min((unsigned)wl,output_len-wv));
+ }
+ return -EINVAL;
+}
+static int bind(struct usb_gadget *g) { req=usb_ep_alloc_request(g->ep0,0); if (!req)return -ENOMEM; req->complete=completed; return 0; }
+static void unbind(struct usb_gadget *g) { if(req) usb_ep_free_request(g->ep0,req); req=0; }
+static void gone(struct usb_gadget *g) {}
+static struct usb_gadget_driver driver={.speed=USB_SPEED_HIGH,.bind=bind,.unbind=unbind,.setup=setup,.disconnect=gone};
+/* EBOOT enables this S5PC110 OTG clock gate first. The U2-specific UDC
+ * path then replays EBOOT's oscillator, PHY and core-reset sequence before
+ * configuring the U-Boot gadget endpoints. */
+static int phy(int on) {
+ if (on) {
+  writel(readl(U2_USB_CLK_GATE) | (1U << 16), U2_USB_CLK_GATE);
+  udelay(1000);
+ }
+ return 0;
+}
+static struct s3c_plat_otg_data pdata={.phy_control=phy};
+int u2probe_start(void) {
+ u32 phy_va,otg_va,ctrl_va;
+ int r;
+ if (u2_eboot_phys_to_virt(U2_USB_PHY,&phy_va) ||
+     u2_eboot_phys_to_virt(U2_USB_OTG,&otg_va) ||
+     u2_eboot_phys_to_virt(U2_USB_CTRL,&ctrl_va)) return -ENODEV;
+ pdata.regs_phy=phy_va; pdata.regs_otg=otg_va; pdata.usb_phy_ctrl=ctrl_va;
+ r=s3c_udc_probe(&pdata); if(r)return r;
+ /* Service EP0 immediately after registration. */
+ r=usb_gadget_register_driver(&driver);
+ return r;
+}
+void u2probe_poll(void) {
+ usb_gadget_handle_interrupts();
+ if (command_state==1) {
+  command_state=2;
+  output_len=0; output_truncated=0; command_result=0;
+  command_result=run_command(command_text,0);
+  command_state=3;
+ }
+}
