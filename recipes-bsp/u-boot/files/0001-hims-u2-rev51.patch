diff --git a/arch/arm/cpu/armv7/s5p-common/timer.c b/arch/arm/cpu/armv7/s5p-common/timer.c
index bb0e795..dde0852 100644
--- a/arch/arm/cpu/armv7/s5p-common/timer.c
+++ b/arch/arm/cpu/armv7/s5p-common/timer.c
@@ -29,6 +29,29 @@
 #include <asm/arch/clk.h>
 #include <pwm.h>
 
+#ifdef CONFIG_HIMS_U2
+/* EBOOT leaves an MMU mapping in place; the stock PWM address is not mapped. */
+static volatile unsigned long u2_soft_ticks;
+
+int timer_init(void) { u2_soft_ticks = 0; return 0; }
+void reset_timer_masked(void) { u2_soft_ticks = 0; }
+unsigned long get_current_tick(void) { return u2_soft_ticks++; }
+unsigned long get_timer_masked(void) { return u2_soft_ticks++; }
+unsigned long get_timer(unsigned long base) { return get_timer_masked() - base; }
+void __udelay(unsigned long usec)
+{
+	/* Conservative software delay until a mapped hardware timer is identified. */
+	while (usec--) {
+		volatile unsigned long count = 200;
+		while (count--)
+			__asm__ __volatile__("nop");
+	}
+}
+unsigned long long get_ticks(void) { return get_timer_masked(); }
+unsigned long get_tbclk(void) { return CONFIG_SYS_HZ; }
+
+#else
+
 DECLARE_GLOBAL_DATA_PTR;
 
 unsigned long get_current_tick(void);
@@ -150,3 +173,4 @@ unsigned long get_tbclk(void)
 {
 	return CONFIG_SYS_HZ;
 }
+#endif
