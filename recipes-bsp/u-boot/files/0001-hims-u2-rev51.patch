diff --git a/arch/arm/cpu/armv7/start.S b/arch/arm/cpu/armv7/start.S
index 7df97c5..d2579cc 100644
--- a/arch/arm/cpu/armv7/start.S
+++ b/arch/arm/cpu/armv7/start.S
@@ -132,6 +132,13 @@ reset:
 	bic	r0, r0, #0x1f
 	orr	r0, r0, #0xd3
 	msr	cpsr,r0
+#ifdef CONFIG_HIMS_U2
+	/* EBOOT has cleared SCTLR.M. Keep the watchdog disabled while
+	 * this physical-address payload owns the board. */
+	ldr	r1, =0xe2700000
+	mov	r0, #0
+	str	r0, [r1]
+#endif
 
 /*
  * Setup vector:
@@ -161,6 +168,12 @@ call_board_init_f:
 	bic	sp, sp, #7 /* 8-byte alignment for ABI compliance */
 	ldr	r0,=0x00000000
 	bl	board_init_f
+#ifdef CONFIG_HIMS_U2
+	/* board_init_f must not return. Halt silently if it does. */
+u2_board_init_returned:
+	b	u2_board_init_returned
+#endif
+
 
 /*------------------------------------------------------------------------------*/
 
@@ -279,6 +292,13 @@ jump_2_ram:
 	mcr     p15, 0, r0, c12, c0, 0  @Set VBAR
 #endif /* !Tegra20 */
 
+#ifdef CONFIG_HIMS_U2
+	/* Rev35: with no relocation, the board_init_r target is within ARM's
+	 * direct branch range. Avoid the cold image's table-derived jump. */
+	mov	r0, r5		/* gd_t */
+	mov	r1, r6		/* dest_addr */
+	b	board_init_r
+#else
 	ldr	r0, _board_init_r_ofs
 	adr	r1, _start
 	add	lr, r0, r1
@@ -288,6 +308,7 @@ jump_2_ram:
 	mov	r1, r6		/* dest_addr */
 	/* jump to it ... */
 	mov	pc, lr
+#endif
 
 _board_init_r_ofs:
 	.word board_init_r - _start
@@ -491,29 +512,51 @@ ENDPROC(cpu_init_crit)
 /*
  * exception handlers
  */
+#ifdef CONFIG_HIMS_U2
+	/* Keep faults finite and silent rather than entering a reboot loop. */
+	.macro u2_fault_halt
+1:	b	1b
+	.endm
+#endif
 	.align	5
 undefined_instruction:
+#ifdef CONFIG_HIMS_U2
+	u2_fault_halt
+#else
 	get_bad_stack
 	bad_save_user_regs
 	bl	do_undefined_instruction
+#endif
 
 	.align	5
 software_interrupt:
+#ifdef CONFIG_HIMS_U2
+	u2_fault_halt
+#else
 	get_bad_stack_swi
 	bad_save_user_regs
 	bl	do_software_interrupt
+#endif
 
 	.align	5
 prefetch_abort:
+#ifdef CONFIG_HIMS_U2
+	u2_fault_halt
+#else
 	get_bad_stack
 	bad_save_user_regs
 	bl	do_prefetch_abort
+#endif
 
 	.align	5
 data_abort:
+#ifdef CONFIG_HIMS_U2
+	u2_fault_halt
+#else
 	get_bad_stack
 	bad_save_user_regs
 	bl	do_data_abort
+#endif
 
 	.align	5
 not_used:
diff --git a/arch/arm/lib/board.c b/arch/arm/lib/board.c
index 109a1ac..ab7a496 100644
--- a/arch/arm/lib/board.c
+++ b/arch/arm/lib/board.c
@@ -65,6 +65,10 @@
 #endif
 
 DECLARE_GLOBAL_DATA_PTR;
+#ifdef CONFIG_HIMS_U2
+extern int serial_init_dev(const int dev_index);
+#endif
+
 
 ulong monitor_flash_len;
 
@@ -268,7 +272,9 @@ init_fnc_t *init_sequence[] = {
 void board_init_f(ulong bootflag)
 {
 	bd_t *bd;
+#ifndef CONFIG_HIMS_U2
 	init_fnc_t **init_fnc_ptr;
+#endif
 	gd_t *id;
 	ulong addr, addr_sp;
 #ifdef CONFIG_PRAM
@@ -296,11 +302,29 @@ void board_init_f(ulong bootflag)
 	gd->fdt_blob = (void *)getenv_ulong("fdtcontroladdr", 16,
 						(uintptr_t)gd->fdt_blob);
 
+#ifdef CONFIG_HIMS_U2
+	/* EBOOT's cold NAND handoff fails before the first indirect call through
+	 * init_sequence. Use the same fixed U2 sequence with direct branches. */
+	if (arch_cpu_init()) hang();
+	if (timer_init()) hang();
+	if (env_init()) hang();
+	if (init_baudrate()) hang();
+	/* generic serial_init() dereferences a .data function pointer. Earlier
+	 * cold EBOOT loads failed at indirect calls; the U2 stub has no UART
+	 * hardware to initialize, so call it directly to isolate that hazard. */
+	if (serial_init_dev(2)) hang();
+	if (console_init_f()) hang();
+	if (display_banner()) hang();
+	if (checkboard()) hang();
+	if (dram_init()) hang();
+#else
 	for (init_fnc_ptr = init_sequence; *init_fnc_ptr; ++init_fnc_ptr) {
 		if ((*init_fnc_ptr)() != 0) {
 			hang ();
 		}
 	}
+#endif
+
 
 #ifdef CONFIG_OF_CONTROL
 	/* For now, put this check after the console is ready */
@@ -330,6 +354,12 @@ void board_init_f(ulong bootflag)
 #endif
 
 	addr = CONFIG_SYS_SDRAM_BASE + gd->ram_size;
+#ifdef CONFIG_HIMS_U2
+	/* Rev41: preserve the real RAM size in gd/boot tags but reserve U-Boot's
+	 * later bd, gd and stack below 14 MiB. The initial stack is at 15 MiB.
+	 * This isolates high-DRAM dependence from relocation-copy failures. */
+	addr = CONFIG_SYS_SDRAM_BASE + 0x00e00000;
+#endif
 
 #ifdef CONFIG_LOGBUFFER
 #ifndef CONFIG_ALT_LB_ADDR
@@ -437,6 +467,12 @@ void board_init_f(ulong bootflag)
 	/* Ram ist board specific, so move it to board code ... */
 	dram_init_banksize();
 	display_dram_config();	/* and display it */
+#ifdef CONFIG_HIMS_U2
+	/* Rev33: the CE carrier already runs at its physical link address.
+	 * Skip the RAM-to-RAM copy and .rel.dyn fixups; keep the separately
+	 * reserved high-DRAM stack and gd established above. */
+	addr = CONFIG_SYS_TEXT_BASE;
+#endif
 
 	gd->relocaddr = addr;
 	gd->start_addr_sp = addr_sp;
@@ -444,6 +480,7 @@ void board_init_f(ulong bootflag)
 	debug("relocation Offset is: %08lx\n", gd->reloc_off);
 	memcpy(id, (void *)gd, sizeof(gd_t));
 
+
 	relocate_code(addr_sp, id, addr);
 
 	/* NOTREACHED - relocate_code() does not return */
@@ -505,8 +542,12 @@ void board_init_r(gd_t *id, ulong dest_addr)
 	post_output_backlog();
 #endif
 
-	/* The Malloc area is immediately below the monitor copy in DRAM */
+	/* The in-place U2 image has no spare RAM immediately below it. */
+#ifdef CONFIG_HIMS_U2
+	malloc_start = CONFIG_SYS_SDRAM_BASE + 0x00800000;
+#else
 	malloc_start = dest_addr - TOTAL_MALLOC_LEN;
+#endif
 	mem_malloc_init (malloc_start, TOTAL_MALLOC_LEN);
 
 #ifdef CONFIG_ARCH_EARLY_INIT_R
diff --git a/rev51/board/hims/u2/Makefile b/board/hims/u2/Makefile
new file mode 100644
index 0000000..b33f8f9
--- /dev/null
+++ b/board/hims/u2/Makefile
@@ -0,0 +1,23 @@
+#
+# BrailleSense U2: an EBOOT-launched S5PV210 payload board.
+#
+# The EBOOT handoff state is deliberate.  EBOOT maps physical DRAM at
+# 0x20000000 into the CE-visible 0x80000000 window before the B000FF entry.
+# Dropping EBOOT's MMU translation would be unsafe on this board.
+#
+include $(TOPDIR)/config.mk
+
+LIB = $(obj)lib$(BOARD).o
+
+COBJS-y := u2.o u2probe.o
+SOBJS := lowlevel_init.o
+
+SRCS := $(SOBJS:.o=.S) $(COBJS-y:.o=.c)
+OBJS := $(addprefix $(obj),$(COBJS-y))
+SOBJS := $(addprefix $(obj),$(SOBJS))
+
+$(LIB): $(obj).depend $(SOBJS) $(OBJS)
+	$(call cmd_link_o_target, $(SOBJS) $(OBJS))
+
+include $(SRCTREE)/rules.mk
+sinclude $(obj).depend
diff --git a/rev51/board/hims/u2/config.mk b/board/hims/u2/config.mk
new file mode 100644
index 0000000..6f787d2
--- /dev/null
+++ b/board/hims/u2/config.mk
@@ -0,0 +1,4 @@
+# The CE-compatible carrier begins at CE VA 0x80020000 (PA 0x40020000),
+# but its U-Boot code begins 0x1000 bytes later, at physical 0x40021000.
+# The frozen revision 7 direct carrier instead links at 0x40020000.
+CONFIG_SYS_TEXT_BASE = 0x40021000
