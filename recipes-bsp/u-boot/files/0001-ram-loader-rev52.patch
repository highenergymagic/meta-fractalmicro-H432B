diff --git a/rev52/board/hims/u2/u2ram.h b/board/hims/u2/u2ram.h
new file mode 100644
index 0000000..2e2e5ce
--- /dev/null
+++ b/board/hims/u2/u2ram.h
@@ -0,0 +1,67 @@
+/* Fixed RAM-only upload slots; no caller-supplied destination addresses. */
+#ifndef U2_RAM_H
+#define U2_RAM_H
+
+#define U2_RAM_SLOTS 3
+#define U2_RAM_EMPTY 0
+#define U2_RAM_RX 1
+#define U2_RAM_VERIFY 2
+#define U2_RAM_VALID 3
+#define U2_RAM_ERROR 4
+
+struct u2_ram_slot {
+ unsigned state, size, received, expected_crc, actual_crc;
+};
+
+static const unsigned u2_ram_address[U2_RAM_SLOTS] = {
+ 0x42000000, 0x44000000, 0x44400000
+};
+static const unsigned u2_ram_limit[U2_RAM_SLOTS] = {
+ 0x02000000, 0x00100000, 0x01000000
+};
+
+static int u2_ram_begin(struct u2_ram_slot *s, unsigned id,
+                        unsigned size, unsigned crc)
+{
+ s->state = U2_RAM_ERROR;
+ s->size = s->received = s->actual_crc = 0;
+ s->expected_crc = crc;
+ if (id >= U2_RAM_SLOTS || !size || size > u2_ram_limit[id]) return -1;
+ s->size = size;
+ s->state = U2_RAM_RX;
+ return 0;
+}
+
+/* Check before copying. Offset is sequential; duplicates are rejected. */
+static int u2_ram_accept(struct u2_ram_slot *s, unsigned offset, unsigned n)
+{
+ if (s->state != U2_RAM_RX || offset != s->received || !n || n > 56 ||
+     s->received > s->size || n > s->size - s->received) {
+  s->state = U2_RAM_ERROR;
+  return -1;
+ }
+ s->received += n;
+ return 0;
+}
+
+static int u2_ram_finish(struct u2_ram_slot *s)
+{
+ if (s->state != U2_RAM_RX || s->received != s->size) {
+  s->state = U2_RAM_ERROR;
+  return -1;
+ }
+ s->state = U2_RAM_VERIFY;
+ return 0;
+}
+
+static int u2_ram_checked(struct u2_ram_slot *s, unsigned crc)
+{
+ s->actual_crc = crc;
+ if (s->state != U2_RAM_VERIFY || crc != s->expected_crc) {
+  s->state = U2_RAM_ERROR;
+  return -1;
+ }
+ s->state = U2_RAM_VALID;
+ return 0;
+}
+#endif
