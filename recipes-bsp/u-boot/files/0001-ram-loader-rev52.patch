+ if (slots[0].size<48 || readl(0x42000024)!=0x016f2818 ||
+     slots[1].size<40 || fdt_check_header((void *)0x44000000) ||
+     fdt_totalsize((void *)0x44000000)>slots[1].size) {
+  puts("Linux refused: invalid zImage or DTB header\n");
+  return CMD_RET_FAILURE;
+ }
+ snprintf(command,sizeof(command),"bootz 42000000 44400000:%x 44000000",slots[2].size);
+ return run_command(command,0);
+}
