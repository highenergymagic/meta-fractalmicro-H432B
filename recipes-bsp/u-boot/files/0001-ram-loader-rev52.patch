index ab7a496..42c415b 100644
--- a/arch/arm/lib/board.c
+++ b/arch/arm/lib/board.c
@@ -355,10 +355,9 @@ void board_init_f(ulong bootflag)
 
 	addr = CONFIG_SYS_SDRAM_BASE + gd->ram_size;
 #ifdef CONFIG_HIMS_U2
-	/* Rev41: preserve the real RAM size in gd/boot tags but reserve U-Boot's
-	 * later bd, gd and stack below 14 MiB. The initial stack is at 15 MiB.
-	 * This isolates high-DRAM dependence from relocation-copy failures. */
-	addr = CONFIG_SYS_SDRAM_BASE + 0x00e00000;
