+static int do_u2linux(cmd_tbl_t *cmdtp,int flag,int argc,char *const argv[]) {
+ unsigned i;
+ char command[96];
+ if (argc!=1) return CMD_RET_USAGE;
+ for (i=0;i<U2_RAM_SLOTS;i++) {
+  if (slots[i].state!=U2_RAM_VALID ||
+      crc32(0,(void *)u2_ram_address[i],slots[i].size)!=slots[i].expected_crc) {
+   puts("Linux refused: all three RAM images must pass CRC verification\n");
+   return CMD_RET_FAILURE;
